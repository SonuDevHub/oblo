# Copy this file to .env.local and fill real values.
#   cp .env.example .env.local
# .env.local is gitignored. NEVER commit real keys. Only this example file goes to git.

# ── Public (safe in browser) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server only (NEVER prefix with NEXT_PUBLIC_, never import in client code) ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Skiper UI Pro (only if using Pro components; never commit) ──
SKIPER_UI_LICENSE_KEY=

# ── App config ──
ID_DOCS_BUCKET=id-documents
ID_DOC_MAX_MB=2
# Optional: restrict signup to college email domain (leave empty to allow all)
ALLOWED_EMAIL_DOMAIN=

# ── Local run (start/stop scripts) ──
PORT=3000
# true = also run local Supabase via Docker (npx supabase start). false = use cloud project above.
USE_LOCAL_SUPABASE=false
